{
	"schemaVersion": 1,
	"id": "minetuner",
	"version": "${version}",
	"name": "MineTuner HUD",
	"description": "Customisable performance HUD for Minecraft.",
	"authors": [
		"bottledpepsi"
	],
	"contact": {
		"homepage": "https://bottledpepsi.github.io",
		"sources": "https://github.com/bottledpepsi/MineTuner-HUD"
	},
	"license": "GPL-3.0",
	"icon": "assets/minetuner/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"bottled.minetuner.MineTunerMod"
		],
		"client": [
			"bottled.minetuner.MineTunerClient"
		],
		"modmenu": [
			"bottled.minetuner.config.cloth.MineTunerModMenuIntegration"
		]
	},
	"mixins": [
		"minetuner.mixins.json",
		{
			"config": "minetuner.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=26.2",
		"java": ">=25",
		"fabric-api": "*",
		"cloth-config": ">=26.2.155"
	},
	"suggests": {
		"modmenu": "*"
	}
}
