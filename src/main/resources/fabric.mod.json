{
	"schemaVersion": 1,
	"id": "mtss",
	"version": "${version}",
	"name": "MineTuner Statistics Server",
	"description": "Customisable performance HUD for Minecraft.",
	"authors": [
		"bottledpepsi"
	],
	"contact": {
		"homepage": "https://bottledpepsi.github.io",
		"sources": "https://github.com/bottledpepsi/MineTuner-Statistics-Server"
	},
	"license": "GPL-3.0",
	"icon": "assets/mtss/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"bottled.mtss.MtssMod"
		],
		"client": [
			"bottled.mtss.MtssClient"
		]
	},
	"mixins": [
		"mtss.mixins.json",
		{
			"config": "mtss.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
