{
	"schemaVersion": 1,
	"id": "perfhud",
	"version": "${version}",
	"name": "PerfHUD",
	"description": "Customisable performance HUD \u2014 multiple stat lists, drag-and-drop positioning, snap-to-centre, per-list color/scale, TPS, FPS, ping, memory, CPU, coords, facing, speed, biome, light level, dimension, and more.",
	"authors": [
		"bottledpepsi"
	],
	"contact": {
		"homepage": "https://bottledpepsi.github.io",
		"sources": "https://github.com/bottledpepsi/perfhud"
	},
	"license": "GPL-3.0",
	"icon": "assets/perfhud/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"bottled.perfhud.PerfHud"
		],
		"client": [
			"bottled.perfhud.PerfHudClient"
		]
	},
	"mixins": [
		"perfhud.mixins.json",
		{
			"config": "perfhud.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}